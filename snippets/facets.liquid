{% if results.filters.size > 0 %}
  <form class="facets" method="get">
    {% if search_terms != blank %}
      <input type="hidden" name="q" value="{{ search_terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
    {% endif %}

    <div class="facets__topline">
      <div class="facets__groups">
        {% for filter in results.filters %}
          <details class="facet">
            <summary>
              <span>{{ filter.label }}</span>
              {% if filter.active_values.size > 0 %}
                <span class="facet__count">{{ filter.active_values.size }}</span>
              {% endif %}
            </summary>

            <div class="facet__panel">
              {% case filter.type %}
                {% when 'boolean' %}
                  <ul class="facet__list" role="list">
                    {% if filter.true_value %}
                      <li>
                        <label>
                          <input
                            type="checkbox"
                            name="{{ filter.true_value.param_name }}"
                            value="{{ filter.true_value.value }}"
                            {% if filter.true_value.active %}checked{% endif %}
                            {% if filter.true_value.count == 0 and filter.true_value.active == false %}disabled{% endif %}
                          >
                          <span>{{ filter.true_value.label }} ({{ filter.true_value.count }})</span>
                        </label>
                      </li>
                    {% endif %}
                    {% if filter.false_value %}
                      <li>
                        <label>
                          <input
                            type="checkbox"
                            name="{{ filter.false_value.param_name }}"
                            value="{{ filter.false_value.value }}"
                            {% if filter.false_value.active %}checked{% endif %}
                            {% if filter.false_value.count == 0 and filter.false_value.active == false %}disabled{% endif %}
                          >
                          <span>{{ filter.false_value.label }} ({{ filter.false_value.count }})</span>
                        </label>
                      </li>
                    {% endif %}
                  </ul>

                {% when 'list' %}
                  <ul class="facet__list" role="list">
                    {% for value in filter.values %}
                      <li>
                        <label>
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span>{{ value.label }} ({{ value.count }})</span>
                        </label>
                      </li>
                    {% endfor %}
                  </ul>

                {% when 'price_range' %}
                  <div class="facet__price">
                    <label>
                      <span>{{ 'facets.from' | t }}</span>
                      <span class="facet__money-input">
                        <span>{{ cart.currency.symbol }}</span>
                        <input
                          name="{{ filter.min_value.param_name }}"
                          type="number"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          {% endif %}
                          placeholder="0"
                        >
                      </span>
                    </label>
                    <label>
                      <span>{{ 'facets.to' | t }}</span>
                      <span class="facet__money-input">
                        <span>{{ cart.currency.symbol }}</span>
                        <input
                          name="{{ filter.max_value.param_name }}"
                          type="number"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          {% endif %}
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        >
                      </span>
                    </label>
                  </div>
              {% endcase %}

              <div class="facet__actions">
                {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}
                  <a class="text-link" href="{{ filter.url_to_remove }}">{{ 'facets.reset' | t }}</a>
                {% endif %}
                <button class="button button--dark" type="submit">{{ 'facets.apply' | t }}</button>
              </div>
            </div>
          </details>
        {% endfor %}
      </div>

      {% if sort_options %}
        <label class="facets__sort">
          <span>{{ 'facets.sort' | t }}</span>
          <select name="sort_by" onchange="this.form.submit()">
            {% for option in sort_options %}
              <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
    </div>

    <div class="active-facets">
      {% assign has_active_filters = false %}
      {% for filter in results.filters %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value or filter.max_value.value %}
            {% assign has_active_filters = true %}
            <a class="active-facet" href="{{ filter.url_to_remove }}">
              {% assign min_value = filter.min_value.value | default: 0 %}
              {% assign max_value = filter.max_value.value | default: filter.range_max %}
              {{ min_value | money }} – {{ max_value | money }} ×
            </a>
          {% endif %}
        {% else %}
          {% for value in filter.active_values %}
            {% assign has_active_filters = true %}
            <a class="active-facet" href="{{ value.url_to_remove }}">{{ filter.label }}: {{ value.label }} ×</a>
          {% endfor %}
        {% endif %}
      {% endfor %}
      {% if has_active_filters and clear_url != blank %}
        <a class="active-facet active-facet--clear" href="{{ clear_url }}">{{ 'facets.clear_all' | t }}</a>
      {% endif %}
    </div>
  </form>
{% endif %}
