<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ localization.language.direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.brand_accent }}">
    <title>{{ shop.name }} — {{ 'password.title' | t }}</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'pages.css' | asset_url | stylesheet_tag }}
    {{ 'a11y.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --page-width: {{ settings.page_width }}px;
        --ma-bg: {{ settings.background_color }};
        --ma-text: {{ settings.text_color }};
        --ma-accent: {{ settings.brand_accent }};
        --ma-muted: {{ settings.muted_color }};
        --button-radius: {{ settings.button_radius }}px;
        --media-radius: {{ settings.media_radius }}px;
      }
    </style>
  </head>
  <body class="template-password">
    <main id="MainContent" class="password-main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
