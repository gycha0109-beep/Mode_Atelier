<section class="section-shell page-width journal">
  <header class="page-header">
    <p class="eyebrow">{{ 'journal.eyebrow' | t }}</p>
    <h1>{{ blog.title }}</h1>
  </header>

  {% if blog.all_tags.size > 0 %}
    <nav class="journal-tags" aria-label="{{ 'journal.tags' | t }}">
      <a href="{{ blog.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>{{ 'journal.all' | t }}</a>
      {% for tag in blog.all_tags %}
        {{ tag | link_to_tag: tag }}
      {% endfor %}
    </nav>
  {% endif %}

  {% paginate blog.articles by section.settings.articles_per_page %}
    <div class="journal-grid">
      {% for article in blog.articles %}
        <article class="journal-card">
          <a href="{{ article.url }}">
            <div class="journal-card__media">
              {% if article.image %}
                {{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 33vw, 100vw' }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'journal-card__placeholder' }}
              {% endif %}
            </div>
            <div class="journal-card__meta">
              <p class="eyebrow">{{ article.published_at | date: '%Y.%m.%d' }}</p>
              <h2>{{ article.title }}</h2>
              {% if article.excerpt != blank %}
                <p>{{ article.excerpt | strip_html | truncatewords: 22 }}</p>
              {% else %}
                <p>{{ article.content | strip_html | truncatewords: 22 }}</p>
              {% endif %}
            </div>
          </a>
        </article>
      {% else %}
        <p>{{ 'journal.empty' | t }}</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [
    { "type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 3, "max": 18, "step": 3, "default": 9 }
  ]
}
{% endschema %}
