<section class="section-shell page-width">
  <header class="page-header">
    <p class="eyebrow">{{ 'collections.list.eyebrow' | t }}</p>
    <h1>{{ 'collections.list.title' | t }}</h1>
  </header>

  <div class="collection-list">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        {% assign collection_image = collection.featured_image | default: collection.products.first.featured_image %}
        <article class="collection-card">
          <a href="{{ collection.url }}" class="collection-card__link">
            <div class="collection-card__media collection-card__media--{{ section.settings.image_ratio }}">
              {% if collection_image %}
                {{ collection_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '420, 720, 1000, 1400', sizes: '(min-width: 990px) 33vw, 100vw' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
              {% endif %}
            </div>
            <div class="collection-card__meta">
              <h2>{{ collection.title }}</h2>
              <span>{{ 'collections.general.product_count' | t: count: collection.products_count }}</span>
            </div>
          </a>
        </article>
      {% endunless %}
    {% else %}
      <p>{{ 'collections.list.empty' | t }}</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    }
  ]
}
{% endschema %}
