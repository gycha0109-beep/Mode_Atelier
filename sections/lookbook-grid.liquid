<section class="lookbook page-width">
  <header class="lookbook__header">
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
  </header>

  <div class="lookbook__grid">
    {% for block in section.blocks %}
      <article class="lookbook-card lookbook-card--{{ block.settings.ratio }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1280, 1600', sizes: '(min-width: 990px) 33vw, 100vw' }}
        {% else %}
          {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'lookbook-card__placeholder' }}
        {% endif %}
        {% if block.settings.caption != blank %}
          <p class="lookbook-card__caption">{{ block.settings.caption }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook grid",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "EDITORIAL 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Between concrete and quiet." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A modular campaign grid for seasonal imagery, styling stories and collection narratives.</p>" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "ratio",
          "label": "Ratio",
          "options": [
            { "value": "portrait", "label": "Portrait" },
            { "value": "square", "label": "Square" },
            { "value": "landscape", "label": "Landscape" }
          ],
          "default": "portrait"
        },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook grid",
      "blocks": [
        { "type": "image", "settings": { "ratio": "portrait", "caption": "Look 01 / Seoul" } },
        { "type": "image", "settings": { "ratio": "landscape", "caption": "Look 02 / In transit" } },
        { "type": "image", "settings": { "ratio": "portrait", "caption": "Look 03 / After dark" } }
      ]
    }
  ]
}
{% endschema %}
