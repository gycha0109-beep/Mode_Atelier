<section class="lookbook-editorial">
  <div class="lookbook-editorial__masthead page-width">
    <div class="lookbook-editorial__masthead-copy">
      <p class="eyebrow">{{ section.settings.kicker }}</p>
      <h1>{{ section.settings.heading }}</h1>
    </div>
    {% if section.settings.text != blank %}
      <div class="lookbook-editorial__intro rte">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  {% assign hero_block = section.blocks.first %}
  {% if hero_block != blank %}
    <figure class="lookbook-editorial__hero" {{ hero_block.shopify_attributes }}>
      <div class="lookbook-editorial__hero-media">
        {% if hero_block.settings.image != blank %}
          {{ hero_block.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '750, 1100, 1500, 1900, 2400',
              sizes: '(min-width: 1500px) 1480px, calc(100vw - 40px)' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-editorial__placeholder' }}
        {% endif %}
      </div>
      <figcaption class="lookbook-editorial__hero-caption page-width">
        <span>{{ hero_block.settings.eyebrow | default: hero_block.settings.caption }}</span>
        {% if hero_block.settings.title != blank %}<strong>{{ hero_block.settings.title }}</strong>{% endif %}
        {% if hero_block.settings.product_name != blank %}<em>{{ hero_block.settings.product_name }}</em>{% endif %}
      </figcaption>
    </figure>
  {% endif %}

  {% if section.blocks.size > 1 %}
    <div class="lookbook-editorial__stories page-width">
      {% for block in section.blocks offset: 1 %}
        <article class="lookbook-story lookbook-story--{{ block.settings.ratio }}" {{ block.shopify_attributes }}>
          <div class="lookbook-story__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1280, 1600, 1800',
                  sizes: '(min-width: 990px) 58vw, 100vw' }}
            {% else %}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag: 'lookbook-editorial__placeholder' }}
            {% endif %}
          </div>

          <div class="lookbook-story__copy">
            <p class="eyebrow">{{ block.settings.eyebrow | default: block.settings.caption }}</p>
            {% if block.settings.title != blank %}<h2>{{ block.settings.title }}</h2>{% endif %}
            {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.product_name != blank %}
              {% if block.settings.link != blank %}
                <a class="lookbook-story__product text-link" href="{{ block.settings.link }}">{{ block.settings.product_name }}</a>
              {% else %}
                <p class="lookbook-story__product">{{ block.settings.product_name }}</p>
              {% endif %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.featured_collection != blank %}
    <div class="lookbook-editorial__shop page-width">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ section.settings.shop_kicker }}</p>
          <h2>{{ section.settings.shop_heading }}</h2>
        </div>
        <a class="text-link" href="{{ section.settings.featured_collection.url }}">{{ section.settings.shop_link_label }}</a>
      </div>
      <div class="lookbook-editorial__product-grid">
        {% for product in section.settings.featured_collection.products limit: 4 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Editorial lookbook",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Season", "default": "AW26" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Between concrete and quiet." },
    { "type": "richtext", "id": "text", "label": "Introduction", "default": "<p>A study of quiet structure, transit, and soft tailoring.</p>" },
    { "type": "collection", "id": "featured_collection", "label": "Shop the edit collection" },
    { "type": "text", "id": "shop_kicker", "label": "Shop kicker", "default": "THE EDIT" },
    { "type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop the edit" },
    { "type": "text", "id": "shop_link_label", "label": "Shop link label", "default": "View collection" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Editorial image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "LOOK 01 / SEOUL" },
        { "type": "text", "id": "title", "label": "Title", "default": "Quiet structure" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Soft tailoring shaped for movement through the city.</p>" },
        { "type": "text", "id": "product_name", "label": "Featured item", "default": "Architectural Wool Jacket" },
        { "type": "url", "id": "link", "label": "Featured item link" },
        {
          "type": "select",
          "id": "ratio",
          "label": "Media ratio",
          "options": [
            { "value": "portrait", "label": "Portrait" },
            { "value": "landscape", "label": "Landscape" },
            { "value": "square", "label": "Square" }
          ],
          "default": "portrait"
        },
        { "type": "text", "id": "caption", "label": "Legacy caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial lookbook",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "eyebrow": "AW26 / SEOUL",
            "title": "Between concrete and quiet.",
            "product_name": "Mode Atelier / Autumn Winter 2026",
            "ratio": "landscape"
          }
        },
        {
          "type": "image",
          "settings": {
            "eyebrow": "LOOK 01 / SEOUL",
            "title": "Quiet structure",
            "text": "<p>Soft tailoring shaped for movement through the city.</p>",
            "product_name": "Architectural Wool Jacket",
            "ratio": "portrait"
          }
        },
        {
          "type": "image",
          "settings": {
            "eyebrow": "MATERIAL 02 / SOFT STRUCTURE",
            "title": "Texture in motion",
            "text": "<p>Layered texture and relaxed proportion, held against a harder urban frame.</p>",
            "product_name": "Soft Structure Knit",
            "ratio": "portrait"
          }
        }
      ]
    }
  ]
}
{% endschema %}
