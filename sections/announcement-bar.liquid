{% if section.settings.text != blank %}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
      <span>{{ section.settings.text }}</span>
    {% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Complimentary global shipping over selected order values" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
