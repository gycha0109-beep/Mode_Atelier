{% assign current_variant = product.selected_or_first_available_variant %}
<section class="product page-width" data-product-section data-product-url="{{ product.url }}">
  <div class="product__gallery">
    {% for media in product.media %}
      <div class="product__media">
        {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 60vw, 100vw' }}
      </div>
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'product__placeholder' }}
    {% endfor %}
  </div>

  <div class="product__info">
    {% if section.settings.show_vendor and product.vendor != blank %}<p class="eyebrow">{{ product.vendor }}</p>{% endif %}
    <h1>{{ product.title }}</h1>
    <div class="product__price" aria-live="polite" data-product-price>{{ current_variant.price | money }}</div>

    {% form 'product', product, id: 'ModeAtelierProductForm', class: 'product-form', data-ajax-product-form: '' %}
      {% unless product.has_only_default_variant %}
        <label for="VariantSelect-{{ section.id }}">{{ 'products.product.variant' | t }}</label>
        <select id="VariantSelect-{{ section.id }}" name="id" data-variant-select>
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-available="{{ variant.available }}"
              data-price="{{ variant.price | money | escape }}"
              {% if variant == current_variant %}selected{% endif %}
            >
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
            </option>
          {% endfor %}
        </select>
      {% else %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% endunless %}

      <label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
      <input id="Quantity-{{ section.id }}" class="quantity-input" type="number" name="quantity" min="1" value="1">

      <button class="button button--dark button--full" type="submit" name="add" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
        <span data-add-to-cart-text>
          {% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
        </span>
      </button>
      {{ form | payment_button }}
    {% endform %}

    <div class="product__description rte">{{ product.description }}</div>

    {% if product.metafields.custom.fit_note.value != blank %}
      <details>
        <summary>{{ 'products.product.fit_note' | t }}</summary>
        <p>{{ product.metafields.custom.fit_note.value | escape }}</p>
      </details>
    {% endif %}

    {% if product.metafields.custom.materials.value != blank %}
      <details>
        <summary>{{ 'products.product.materials' | t }}</summary>
        <div class="rte">{{ product.metafields.custom.materials.value | escape | newline_to_br }}</div>
      </details>
    {% endif %}

    {% if product.metafields.custom.care.value != blank %}
      <details>
        <summary>{{ 'products.product.care' | t }}</summary>
        <div class="rte">{{ product.metafields.custom.care.value | escape | newline_to_br }}</div>
      </details>
    {% endif %}

    {% if product.metafields.custom.model_info.value != blank %}
      <details>
        <summary>{{ 'products.product.model_info' | t }}</summary>
        <p>{{ product.metafields.custom.model_info.value | escape }}</p>
      </details>
    {% endif %}

    {% if section.settings.size_guide_page != blank %}
      <details>
        <summary>{{ 'products.product.size_guide' | t }}</summary>
        <div class="rte">{{ section.settings.size_guide_page.content }}</div>
      </details>
    {% endif %}

    <details>
      <summary>{{ 'products.product.shipping_returns' | t }}</summary>
      <p>{{ 'products.product.shipping_returns_body' | t }}</p>
    </details>

    <details>
      <summary>{{ 'products.product.global_checkout' | t }}</summary>
      <p>{{ 'products.product.global_checkout_body' | t }}</p>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "page", "id": "size_guide_page", "label": "Size guide page" }
  ]
}
{% endschema %}
