<section class="section-shell page-width contact-page">
  <header class="page-header">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1>{{ page.title | default: 'Contact' }}</h1>
    {% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}
  </header>

  <div class="contact-layout">
    <div class="contact-intro">
      <p class="eyebrow">{{ 'contact.details_eyebrow' | t }}</p>
      <p>{{ 'contact.details_body' | t }}</p>
    </div>

    {% form 'contact', class: 'contact-form' %}
      {% if form.posted_successfully? %}
        <div class="form-status" role="status" tabindex="-1">
          <h2>{{ 'contact.success_title' | t }}</h2>
          <p>{{ 'contact.success_body' | t }}</p>
        </div>
      {% else %}
        {% if form.errors %}
          <div class="form-errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="field-grid">
          <div class="field">
            <label for="ContactName">{{ 'contact.name' | t }}</label>
            <input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% endif %}">
          </div>

          <div class="field">
            <label for="ContactEmail">{{ 'contact.email' | t }}</label>
            <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{% if form.email %}{{ form.email | escape }}{% endif %}">
          </div>
        </div>

        <div class="field">
          <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
          <input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{% if form.phone %}{{ form.phone | escape }}{% endif %}">
        </div>

        <div class="field">
          <label for="ContactMessage">{{ 'contact.message' | t }}</label>
          <textarea id="ContactMessage" name="contact[body]" rows="8" required aria-required="true">{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
        </div>

        <button class="button button--dark" type="submit">{{ 'contact.submit' | t }}</button>
      {% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Main contact",
  "settings": []
}
{% endschema %}
