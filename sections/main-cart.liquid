<section class="section-shell page-width cart">
  <header class="page-header">
    <p class="eyebrow">{{ 'cart.general.eyebrow' | t }}</p>
    <h1>{{ 'cart.general.title' | t }}</h1>
  </header>

  {% if cart.item_count == 0 %}
    <div class="empty-state">
      <p>{{ 'cart.general.empty' | t }}</p>
      <a class="button button--dark" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart__items">
        {% for item in cart.items %}
          <article class="cart-item">
            <a href="{{ item.url }}" class="cart-item__image">
              {% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy' }}{% endif %}
            </a>
            <div class="cart-item__content">
              <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
              {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}
              <p>{{ item.final_price | money }}</p>
              <label for="updates_{{ item.key }}">{{ 'cart.general.quantity' | t }}</label>
              <input id="updates_{{ item.key }}" class="quantity-input" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" type="number">
              <a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.general.remove' | t }}</a>
            </div>
            <div class="cart-item__total">{{ item.final_line_price | money }}</div>
          </article>
        {% endfor %}
      </div>

      <aside class="cart-summary">
        <div class="cart-summary__row"><span>{{ 'cart.general.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
        <p class="cart-summary__note">{{ 'cart.general.taxes_shipping' | t }}</p>
        <div class="cart-summary__actions">
          <button class="button" type="submit" name="update">{{ 'cart.general.update' | t }}</button>
          <button class="button button--dark" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </aside>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
