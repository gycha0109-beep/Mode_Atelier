<section class="hero-editorial">
  <div class="hero-editorial__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '720, 1080, 1440, 2000, 2400', sizes: '100vw', class: 'hero-editorial__image' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-editorial__placeholder' }}
    {% endif %}
  </div>
  <div class="hero-editorial__overlay page-width">
    {% if section.settings.kicker != blank %}<p class="eyebrow">{{ section.settings.kicker }}</p>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "AUTUMN / WINTER 26" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quiet structure. Global attitude." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A synthetic fashion label created to demonstrate a production-minded Shopify launch." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Editorial hero" }
  ]
}
{% endschema %}
