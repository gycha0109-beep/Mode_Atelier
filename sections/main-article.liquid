<article class="article page-width">
  <header class="article__header">
    <p class="eyebrow">{{ blog.title }} · {{ article.published_at | date: '%Y.%m.%d' }}</p>
    <h1>{{ article.title }}</h1>
    {% if article.author != blank %}<p class="article__author">{{ 'journal.by_author' | t: author: article.author }}</p>{% endif %}
  </header>

  {% if article.image %}
    <div class="article__hero">
      {{ article.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '720, 1080, 1440, 1800, 2200', sizes: '100vw' }}
    </div>
  {% endif %}

  <div class="article__content rte">
    {{ article.content }}
  </div>

  {% if article.tags.size > 0 %}
    <div class="article__tags" aria-label="{{ 'journal.tags' | t }}">
      {% for tag in article.tags %}
        {{ tag | link_to_tag: tag }}
      {% endfor %}
    </div>
  {% endif %}

  <nav class="article__navigation" aria-label="{{ 'journal.article_navigation' | t }}">
    {% if blog.previous_article %}
      <a class="text-link" href="{{ blog.previous_article.url }}">← {{ blog.previous_article.title }}</a>
    {% endif %}
    {% if blog.next_article %}
      <a class="text-link" href="{{ blog.next_article.url }}">{{ blog.next_article.title }} →</a>
    {% endif %}
  </nav>

  {% if blog.comments_enabled? %}
    <section class="article-comments" aria-labelledby="CommentsHeading">
      <h2 id="CommentsHeading">{{ 'journal.comments' | t }}</h2>

      {% paginate article.comments by 20 %}
        {% for comment in article.comments %}
          <article class="article-comment">
            <p>{{ comment.content }}</p>
            <footer>{{ comment.author }} · {{ comment.created_at | date: '%Y.%m.%d' }}</footer>
          </article>
        {% endfor %}

        {% if paginate.pages > 1 %}
          <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'comment-form' %}
        {% if form.posted_successfully? %}
          <p class="form-status" role="status">{{ 'journal.comment_success' | t }}</p>
        {% endif %}

        {% if form.errors %}
          <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="field-grid">
          <div class="field">
            <label for="CommentAuthor">{{ 'journal.name' | t }}</label>
            <input id="CommentAuthor" type="text" name="comment[author]" autocomplete="name" value="{{ form.author | escape }}" required>
          </div>
          <div class="field">
            <label for="CommentEmail">{{ 'journal.email' | t }}</label>
            <input id="CommentEmail" type="email" name="comment[email]" autocomplete="email" value="{{ form.email | escape }}" required>
          </div>
        </div>

        <div class="field">
          <label for="CommentBody">{{ 'journal.comment' | t }}</label>
          <textarea id="CommentBody" name="comment[body]" rows="7" required>{{ form.body | escape }}</textarea>
        </div>

        <button class="button button--dark" type="submit">{{ 'journal.submit_comment' | t }}</button>
      {% endform %}
    </section>
  {% endif %}
</article>

{% schema %}
{
  "name": "Main article",
  "settings": []
}
{% endschema %}
