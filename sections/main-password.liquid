<section class="password-page page-width">
  <div class="password-page__brand">
    <p class="wordmark">{{ shop.name }}</p>
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {% unless shop.password_message == blank %}
      <div class="rte password-page__message">{{ shop.password_message }}</div>
    {% endunless %}
    {% if section.settings.text != blank %}
      <div class="rte password-page__message">{{ section.settings.text }}</div>
    {% endif %}
  </div>

  <div class="password-page__forms">
    <div>
      <p class="eyebrow">{{ 'password.access' | t }}</p>
      {% form 'storefront_password', class: 'password-form' %}
        {% if form.errors %}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="field">
          <label for="StorefrontPassword">{{ 'password.password' | t }}</label>
          <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button class="button button--dark" type="submit">{{ 'password.enter' | t }}</button>
      {% endform %}
    </div>

    <div>
      <p class="eyebrow">{{ 'password.updates' | t }}</p>
      {% form 'customer', class: 'password-form' %}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        {% if form.posted_successfully? %}
          <p class="form-status" role="status">{{ 'password.success' | t }}</p>
        {% else %}
          {% if form.errors %}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <div class="field">
            <label for="PasswordEmail">{{ 'password.email' | t }}</label>
            <input id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <button class="button" type="submit">{{ 'password.notify' | t }}</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "MODE ATELIER / LAUNCH 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A new uniform is taking shape." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Enter the private access password or join the list for launch notes.</p>" }
  ]
}
{% endschema %}
