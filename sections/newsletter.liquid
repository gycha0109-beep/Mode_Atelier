<section class="newsletter page-width">
  <div>
    <p class="eyebrow">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% form 'customer', class: 'newsletter__form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {% if form.posted_successfully? %}
      <p role="status">{{ 'newsletter.success' | t }}</p>
    {% else %}
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
      <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
      <button class="button button--dark" type="submit">{{ 'newsletter.submit' | t }}</button>
      {% if form.errors %}<div class="newsletter__error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "PRIVATE NOTES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collection releases, without the noise." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
