<section class="editorial-split page-width">
  <div class="editorial-split__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 990px) 55vw, 100vw' }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'editorial-split__placeholder' }}
    {% endif %}
  </div>
  <div class="editorial-split__content">
    {% if section.settings.kicker != blank %}<p class="eyebrow">{{ section.settings.kicker }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}
      <a class="text-link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "THE ATELIER" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for movement between cities." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mode Atelier explores restrained silhouettes, tactile materials and seasonless layering for an international wardrobe.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover the story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Image with text" }
  ]
}
{% endschema %}
