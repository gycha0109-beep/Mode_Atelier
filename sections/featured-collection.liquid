<section class="section-shell page-width">
  <div class="section-heading">
    <div>
      {% if section.settings.kicker != blank %}<p class="eyebrow">{{ section.settings.kicker }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.collection != blank %}
      <a class="text-link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>
    {% endif %}
  </div>

  <div class="product-grid">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>{{ 'collections.general.no_matches' | t }}</p>
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
        <article class="product-card product-card--placeholder">
          {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__placeholder' }}
          <div class="product-card__meta">
            <p>Mode Atelier Sample {{ i }}</p>
            <p>{{ 180000 | money }}</p>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "CURATED NOW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
